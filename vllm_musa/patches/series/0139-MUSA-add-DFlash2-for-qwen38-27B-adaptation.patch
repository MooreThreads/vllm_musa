+    next_ids = {}
+
+    def allocate(num_blocks: int, group_id: int) -> list[int]:
+        separate = mamba_capacity is not None and isinstance(
+            config.kv_cache_groups[group_id].kv_cache_spec, MambaSpec
+        )
+        pool_id = group_id if separate else -1
+        capacity = mamba_capacity if separate else config.num_blocks
+        start = next_ids.get(pool_id, 1)
+        end = start + num_blocks
+        if num_blocks < 0 or end > capacity:
+            raise ValueError(
+                f"Warmup group {group_id}: allocation [{start}, {end}) "
+                f"exceeds pool capacity {capacity}"
+            )
+        next_ids[pool_id] = end
+        return list(range(start, end))
+
+    return allocate
